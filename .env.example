# -------------------------------------------------------------
# APPLICATION & SERVER
# -------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SERVICE_NAME=invitation-api

# -------------------------------------------------------------
# DATABASE (PostgreSQL - Prisma v7 Driver Adapter)
# -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invitation_db?schema=public"

# -------------------------------------------------------------
# CORS & FRONTEND
# -------------------------------------------------------------
FRONTEND_URL="http://localhost:3000,http://localhost:5173"
CORS_ORIGIN="*"

# -------------------------------------------------------------
# AUTHENTICATION & TOKENS
# -------------------------------------------------------------
JWT_SECRET="super-secret-jwt-key-for-invitation-platform"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="super-secret-refresh-jwt-key"
JWT_REFRESH_EXPIRES_IN="7d"

# -------------------------------------------------------------
# PHONE OTP CONFIGURATION
# -------------------------------------------------------------
OTP_SECRET="super-secret-otp-hmac-salt"
OTP_COOLDOWN_SECONDS=60
OTP_EXPIRY_SECONDS=300

# -------------------------------------------------------------
# CLOUDFLARE R2 / S3 STORAGE (Presigned Upload URLs)
# -------------------------------------------------------------
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="invitation-media"
R2_PUBLIC_DOMAIN="https://cdn.aura-invite.com"

# -------------------------------------------------------------
# REDIS & QUEUES (Optional for local development)
# -------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# -------------------------------------------------------------
# LOGGING
# -------------------------------------------------------------
LOG_LEVEL="debug"
