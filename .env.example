# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SERVICE_NAME=invitation-api

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invitation_db?schema=public"

# CORS
CORS_ORIGIN="*"

# Authentication & Security
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key"
JWT_REFRESH_EXPIRES_IN="7d"
OTP_SECRET="your-otp-salt-secret"
OTP_COOLDOWN_SECONDS=60
OTP_EXPIRY_SECONDS=300

# Cloudflare R2 / S3 Storage (Presigned URLs)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="invitation-media"
R2_PUBLIC_DOMAIN=""
